 <body>
-  <canvas id="canvas" width="640" height="400"></canvas>
-  <!-- Wire your build output in here. -->
+  <main>
+    <h1>Doom — shareware Episode 1</h1>
+    <p id="status" data-state="loading" role="status" aria-live="polite">Loading engine and game data…</p>
+    <button id="start" type="button" disabled>Start Doom</button>
+    <button id="fullscreen" type="button">Fullscreen</button>
+    <canvas id="canvas" width="640" height="400" tabindex="0" aria-label="Doom game screen"></canvas>
+    <p>Click the game to focus. Arrows: move/turn · Ctrl: fire · Space: use · Shift: run · Enter/Escape: menus.</p>
+    <p>Keyboard play. Sound and persistent saves are not enabled in this build.</p>
+    <p id="error" role="alert"></p>
+    <noscript>JavaScript and WebAssembly are required to play.</noscript>
+  </main>
+  <script>
+    'use strict';
+    const gameCanvas = document.getElementById('canvas');
+    const startButton = document.getElementById('start');
+    const statusLine = document.getElementById('status');
+    function showFailure(message) {
+      statusLine.dataset.state = 'error';
+      statusLine.textContent = 'Unable to run Doom.';
+      document.getElementById('error').textContent = String(message);
+      startButton.disabled = true;
+    }
+    // Global non-modularized Emscripten Module, defined before doom.js loads.
+    var Module = {
+      canvas: gameCanvas,
+      noInitialRun: true,
+      arguments: ['-iwad', '/doom1.wad'],
+      print: function (text) { console.log(text); },
+      printErr: function (text) { console.error(text); },
+      onAbort: showFailure,
+      onRuntimeInitialized: function () {
+        if (statusLine.dataset.state === 'error') return;
+        statusLine.textContent = 'Ready. Press Start Doom, then use the keyboard.';
+        statusLine.dataset.state = 'ready';
+        startButton.disabled = false;
+      }
+    };
+    startButton.addEventListener('click', function () {
+      // A disabled button also has a state guard for synthetic/repeated clicks.
+      if (statusLine.dataset.state !== 'ready') return;
+      startButton.disabled = true;
+      gameCanvas.focus();
+      statusLine.dataset.state = 'running';
+      statusLine.textContent = 'Running Doom. Title/demo is normal; press Escape for the menu, then choose New Game.';
+      // Do not await the lifetime of the engine's Asyncify continuation.
+      // "running" means startup was requested, not proof of rendered gameplay.
+      try { Module.callMain(Module.arguments.slice()); }
+      catch (error) { showFailure(error); }
+    });
+    gameCanvas.addEventListener('click', function () { gameCanvas.focus(); });
+    document.getElementById('fullscreen').addEventListener('click', function () {
+      if (gameCanvas.requestFullscreen) {
+        gameCanvas.requestFullscreen().catch(function (error) {
+          document.getElementById('error').textContent = 'Fullscreen: ' + error.message;
+        });
+      }
+      gameCanvas.focus();
+    });
+    window.addEventListener('error', function (event) { showFailure(event.message || 'Script load failed.'); });
+    window.addEventListener('unhandledrejection', function (event) { showFailure(event.reason); });
+  </script>
+  <script src="doom.js" onerror="showFailure('Could not load doom.js. Serve the complete dist directory over HTTP.')"></script>
 </body>
 </html>
