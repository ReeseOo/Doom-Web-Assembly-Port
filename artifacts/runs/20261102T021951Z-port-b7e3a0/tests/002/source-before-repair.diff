+  <script>
+    'use strict';
+    const gameCanvas = document.getElementById('canvas');
+    const startButton = document.getElementById('start');
+    const statusLine = document.getElementById('status');
+    function showFailure(message) {
+      statusLine.textContent = 'Unable to run Doom.';
+      document.getElementById('error').textContent = String(message);
+      startButton.disabled = true;
+    }
+    // Global non-modularized Emscripten Module, defined before doom.js loads.
+    var Module = {
+      canvas: gameCanvas,
+      noInitialRun: true,
+      arguments: ['-iwad', '/doom1.wad'],
+      print: function (text) { console.log(text); },
+      printErr: function (text) { console.error(text); },
+      onAbort: showFailure,
+      onRuntimeInitialized: function () {
+        statusLine.textContent = 'Ready. Press Start Doom, then use the keyboard.';
+        startButton.disabled = false;
+      }
+    };
+    startButton.addEventListener('click', function () {
+      startButton.disabled = true;
+      gameCanvas.focus();
+      statusLine.textContent = 'Running Doom.';
